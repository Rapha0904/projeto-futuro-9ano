rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return signedIn() && request.auth.token.email != null;
    }

    function owner() {
      return hasEmail()
        && request.auth.token.email == "raphael122362@gmail.com";
    }

    function authorizedStaff() {
      return owner()
        || (
          hasEmail()
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
          && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.ativa == true
          && (
            get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == "admin"
            || get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == "coord"
          )
        );
    }

    function fullAdmin() {
      return owner()
        || (hasEmail()
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
          && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.ativa == true
          && get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == "admin");
    }

    match /turmas/{turmaId} {
      // Students can query active classes. Staff can read all classes.
      allow read: if (signedIn() && resource.data.ativa == true) || authorizedStaff();
      allow create, update, delete: if fullAdmin();
    }

    match /admins/{email} {
      // The owner manages all access records. Each authorized user may read
      // only their own access record so the panel can validate their profile.
      allow read: if owner()
        || (signedIn()
          && request.auth.token.email != null
          && request.auth.token.email == email);
      allow create, update, delete: if owner();
    }

    match /respostas/{uid} {
      allow create: if signedIn()
        && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/respostas/$(uid))
        && request.resource.data.uid == request.auth.uid;
      allow read: if authorizedStaff()
        || (signedIn() && uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /resultados/{uid} {
      allow create: if signedIn()
        && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/resultados/$(uid))
        && request.resource.data.uid == request.auth.uid;
      allow read: if authorizedStaff()
        || (signedIn() && uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}