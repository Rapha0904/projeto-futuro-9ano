rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "raphael122362@gmail.com";
    }

    match /turmas/{turmaId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ativa == true);
      allow create, update, delete: if isAdmin();
    }

    match /respostas/{uid} {
      allow create: if request.auth != null
        && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/respostas/$(uid))
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin()
        || (request.auth != null && uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /resultados/{uid} {
      allow create: if request.auth != null
        && uid == request.auth.uid
        && !exists(/databases/$(database)/documents/resultados/$(uid))
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin()
        || (request.auth != null && uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}